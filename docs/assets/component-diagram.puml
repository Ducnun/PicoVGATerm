@startuml Component-Diagram

package renderer{
    class renderer{
        + renderer_draw_char( px,  py,  c,  fg,  bg) : void
        + renderer_draw_raw_char( px,  py,  c,  fg,  bg) : void
        + renderer_scroll_vertical( lines) : void
        + renderer_fill_rectangle( px,  py,  height,  width,  color): void
    }

    class fonts{
        + font_get_glyph(c): const uint8_t
        + set_font(f): void
        - const font_t FONT_COMPUTER
        - const font_t FONT_EVEREST
        - const font_t FONT_ENVIOUS
    }

    struct font_t{
        const uint8_t* bitmap;
        uint8_t height;
        uint8_t width;
    }

    enum color_t{
        BLACK,
        WHITE,
        RED,
        CYAN,
        PURPLE,
        GREEN,
        BLUE,
        YELLOW,
        ORANGE,
        BROWN,
        PINK,
        DARK_GREY,
        MID_GREY,
        LIME,
        VIOLET,
        LIGHT_GREY,
    }
}

package video{
    struct framebuffer_t{
        uint8_t* data;
        uint16_t height;
        uint16_t width;
        uint16_t line_stride;
    }

    class vga{
        - uint8_t write_ptr*
        + start_vga(pio): void
        + get_framebuffer: framebuffer_t
    }

    class hsync{
        + hsync_program_init(pio, sm, offset, pin, div): void
    }

    class vsync{
        + hsync_program_init(pio, sm, offset, pin, div): void
    }

    class rgb{
        + rgb_program_init(PIO pio, uint sm, uint offset, uint pin, uint8_t div): void
    }
}

package stream{
    struct stream_state_t {
        STREAM_RX_STATE  rx_state;
        STREAM_CMD cmd;
        uint8_t length;
        uint8_t data[STREAM_MAX_PAYLOAD];
        uint8_t buf_idx;
        bool seq_initialized;
        uint8_t prev_seq;
        uint8_t seq;
        uint8_t crc;
    }

    enum STREAM_CMD{
        STREAM_CMD_SYNC_BYTE    = 0xFF,
        STREAM_CMD_ACK_BYTE     = 0xFE,
        STREAM_CMD_NACK_BYTE    = 0xFD,
        STREAM_CMD_PRINT_CHAR   = 0x01,
        STREAM_CMD_PRINT_STRING = 0x02,
        STREAM_CMD_NEWLINE      = 0x03,
        STREAM_CMD_BACKSPACE    = 0x04,
        STREAM_CMD_REDRAW_LINE  = 0x05,
        STREAM_CMD_SET_CURSOR   = 0x10,
        STREAM_CMD_GET_CURSOR   = 0x11,
        STREAM_CMD_SET_CURSOR_VISIBLE = 0x12,
        STREAM_CMD_SET_FG       = 0x20,
        STREAM_CMD_SET_BG       = 0x21,
        STREAM_CMD_CLEAR        = 0x30,
        STREAM_CMD_SCROLL       = 0x31,
        STREAM_CMD_RESYNC       = 0x80,
    }

    enum STREAM_RX_STATE{
        STREAM_RX_STATE_IDLE,
        STREAM_RX_STATE_CMD,
        STREAM_RX_STATE_LEN,
        STREAM_RX_STATE_ARG,
        STREAM_RX_STATE_SEQ,
        STREAM_RX_STATE_CRC,
    }

    class stream{
        + stream_uart_init() : void
        + stream_poll_event() : void
        + stream_rx(b) : void
        + stream_handle_command() : void
    }
}

package terminal{
    package "terminal_types"{
        struct terminal_cell_t{
            char        c;
            color_t     fg;
            color_t     bg;
            uint8_t     flags;
        }

        struct terminal_line_t{
            uint16_t    length;
            uint8_t     flags;
        }

        struct cursor_t{
            uint8_t     x;
            uint8_t     y;
            bool        visible;
        }

        struct terminal_t {
            uint16_t            cols;
            uint16_t            rows;
            uint16_t            viewport_start;
            cursor_t*           cursor;
            terminal_cell_t*    cells;
            terminal_line_t*    lines;
            color_t             default_fg;
            color_t             default_bg; 
        }
    }

    class terminal_core{
        + terminal_get_const(x, y) : const terminal_t*
        + terminal_get_cell_const(x, y) : const terminal_cell_t*
        + terminal_clear_cell_flags(x, y, mask): void

        + terminal_init() : void
        + terminal_set_default_fg(color): void
        + terminal_set_default_bg(color): void
        + terminal_print_char(c): void
        + terminal_backspace(): void
        + terminal_newline(): void
        + terminal_clear(): void

        - cursor_t cursor
        - terminal_cell_t screencells[]
        - terminal_line_t screenlines[]
    }

    class terminal_render{
        + terminal_flush(): void
        + terminal_render_cursor(): void
    }
}


class main{
    + main(): int
}

main --d> video.vga
video.vga --d> framebuffer_t
video.vga --d> hsync
video.vga --d> vsync
video.vga --d> rgb

main --d> terminal.terminal_render
terminal.terminal_types.terminal_t -d-* terminal.terminal_types.cursor_t
terminal.terminal_types.terminal_t -d-* terminal.terminal_types.terminal_line_t
terminal.terminal_types.terminal_t -d-* terminal.terminal_types.terminal_cell_t
terminal.terminal_core --d> terminal.terminal_types.terminal_t

terminal.terminal_render --d> terminal.terminal_core
terminal.terminal_render --d> renderer.renderer

renderer.renderer --d> renderer.fonts
renderer.renderer --d> renderer.color_t
renderer.renderer --d> video.vga
renderer.fonts --d> renderer.font_t

main --d> stream.stream
stream.stream --d> stream.stream_state_t
stream.stream_state_t --d> stream.STREAM_CMD
stream.stream_state_t --d> stream.STREAM_RX_STATE

stream.stream --d> terminal.terminal_core

@enduml