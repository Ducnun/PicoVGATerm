.program rgb

; Program that handles the scanline outputs at pixel clock speeds
; Autopull handles filling the TX FIFO when a threshold is met (8 bits)
; This then pulls data from the DMA channel attached to the PIO SM

pull block  ; We again pull the delay from the OSR register once
mov y, osr  ; We will pull pixel data into osr later so y is used as more permanent storage

.wrap_target

set pins, 0     ; set pixels black during blanking
mov x, y        ; Now we copy our permanent y storage into our counting register x

wait 1 irq 1    ; We wait for a new active line signal from the vsync program

; Pull and output data for every pixel
colorout:
    out pins, 8
    jmp x-- colorout
.wrap


% c-sdk {
static inline void rgb_program_init(PIO pio, uint sm, uint offset, uint pin, uint8_t div) {
    pio_sm_config c = rgb_program_get_default_config(offset);

    sm_config_set_set_pins(&c, pin, 8);
    sm_config_set_out_pins(&c, pin, 8);

    // longer FIFO to avoid bursty data
    sm_config_set_fifo_join (&c, PIO_FIFO_JOIN_TX) ;

    sm_config_set_clkdiv(&c, div) ;

    // Set this pin's GPIO function (connect PIO to the pad)
    for (int i = 0; i < 8; i++){
        pio_gpio_init(pio, pin + i);
    }
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 8, true);
    pio_sm_init(pio, sm, offset, &c);
}
%}